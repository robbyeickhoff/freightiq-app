{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "production-internal-android": {
      "distribution": "internal",
      "environment": "production",
      "env": {
        "APP_VARIANT": "development"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-navigation-test": {
      "extends": "production",
      "environment": "production",
      "env": {
        "FREIGHTIQ_EMBEDDED_NAVIGATION": "1"
      }
    },
    "production-road-restriction-test": {
      "extends": "production-navigation-test",
      "env": {
        "FREIGHTIQ_STOP_RESTRICTION_TEST": "1",
        "EXPO_PUBLIC_FREIGHTIQ_STOP_RESTRICTION_TEST": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "alpha"
      },
      "ios": {
        "ascAppId": "6760375145"
      }
    }
  }
}

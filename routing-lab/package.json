{
  "name": "routing-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/verify-fixture.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:macro-flow-validation": "node --experimental-strip-types scripts/verify-macro-flow-validation.ts",
    "test:gj-geocoding-polygon": "node --experimental-strip-types scripts/verify-gj-geocoding-polygon.ts",
    "test:route-taxonomy-compatibility": "node --experimental-strip-types scripts/verify-route-taxonomy-compatibility.ts",
    "test:route-reordering": "node --experimental-strip-types scripts/verify-route-reordering.ts",
    "test:zone-learning": "node --experimental-strip-types scripts/verify-zone-learning.ts",
    "typecheck": "tsc -b --pretty false",
    "audit": "npm audit --audit-level=high",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/react": "0.5.0",
    "@supabase/supabase-js": "2.110.8",
    "heic-to": "1.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "oxlint": "1.71.0",
    "typescript": "6.0.2",
    "vite": "8.1.5"
  }
}

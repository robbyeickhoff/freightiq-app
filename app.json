{
  "expo": {
    "name": "FreightIQ",
    "slug": "mfi",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "mfi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "buildNumber": "7",
      "icon": "./assets/images/app-icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.robbyeickhof.mfi",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["comgooglemaps", "waze"]
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "FreightIQ uses your location on this device to show nearby map conditions and, when you start Driving Alerts, warn about nearby conditions.",
          "locationAlwaysAndWhenInUsePermission": "During a Driving Alerts session, FreightIQ checks your location on this device for nearby conditions while you use other apps. Stop the session at any time in FreightIQ.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/images/android-icon-monochrome.png"
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "operations-nearby-v1",
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#F39A3F"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0b0f14",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow FreightIQ to use Face ID to unlock your signed-in app on this device."
        }
      ],
      "./plugins/withNavigationAppQueries.js"
    ],
    "android": {
      "icon": "./assets/images/app-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.robbyeickhof.mfi"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b81e86a8-2227-4492-aa98-085bd2c0072e"
      }
    },
    "owner": "robbyeickhof"
  }
}
